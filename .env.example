PORT=5000
APP_MODE=MOCK
# MEMORY never connects to MONGODB_URI. Set MONGODB for persistent local/demo data.
MOCK_DATABASE=MEMORY
MONGODB_URI= mongodb_connection_string
JWT_SECRET=dummy-jwt-secret-change-this-before-production-2026
FRONTEND_URL=http://localhost:5173
GOOGLE_CLIENT_ID=dummy-google-client-123456789.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=dummy-google-secret-abc123xyz
SMS_PROVIDER=MOCK
SMS_API_KEY=dummy-sms-api-key-123456789
SMS_API_SECRET=dummy-sms-secret-987654321
SIGNZY_BASE_URL=https://dummy.signzy.example
SIGNZY_CLIENT_ID=dummy-signzy-client-id-123456
SIGNZY_CLIENT_SECRET=dummy-signzy-secret-abcdef123456
SIGNZY_API_KEY=dummy-signzy-api-key-999999999
PERFIOS_BASE_URL=https://dummy.perfios.example
PERFIOS_CLIENT_ID=dummy-perfios-client-id-123456
PERFIOS_CLIENT_SECRET=dummy-perfios-secret-abcdef123456
PERFIOS_API_KEY=dummy-perfios-api-key-999999999
CREDIT_PROVIDER=MOCK
CREDIT_BUREAU_API_KEY=dummy-credit-bureau-key-123456
CREDIT_BUREAU_CLIENT_ID=dummy-credit-client-id
CREDIT_BUREAU_SECRET=dummy-credit-secret
BANK_PROVIDER=MOCK
BANK_PARTNER_API_URL=https://dummy-bank-api.example
BANK_PARTNER_API_KEY=dummy-bank-partner-api-key-123456789
FILE_STORAGE_MODE=LOCAL
MAX_UPLOAD_MB=10
LOCAL_OCR_ENABLED=true
# AI is independent of APP_MODE. MOCK explicitly enables a labeled, non-model demo.
AI_PROVIDER=DISABLED
OPENAI_API_KEY=
GROQ_API_KEY=
# For GROQ use openai/gpt-oss-20b; API keys stay scoped to their provider.
AI_MODEL=
